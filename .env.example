# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional live operations costing connectors (server-side only; never expose these with NEXT_PUBLIC_)
# Supabase live costing: use a secure internal/proxy endpoint if your Supabase plan exposes billing data through API.
SUPABASE_COST_ENDPOINT=
SUPABASE_COST_TOKEN=
SUPABASE_COST_CURRENT_PATH=currentMonthCost
SUPABASE_COST_PREVIOUS_PATH=previousMonthCost
SUPABASE_COST_CURRENCY_PATH=currency
SUPABASE_ACCESS_TOKEN=
SUPABASE_DASHBOARD_URL=https://supabase.com/dashboard/project/[project-ref]

# Netlify live costing: use a secure internal/proxy endpoint or approved billing export/API endpoint.
NETLIFY_COST_ENDPOINT=
NETLIFY_COST_TOKEN=
NETLIFY_COST_CURRENT_PATH=currentMonthCost
NETLIFY_COST_PREVIOUS_PATH=previousMonthCost
NETLIFY_COST_CURRENCY_PATH=currency
NETLIFY_AUTH_TOKEN=
NETLIFY_ACCOUNT_SLUG=
NETLIFY_DASHBOARD_URL=https://app.netlify.com/

# Optional JSON array for any other monitored provider cost feeds.
# Example item fields: id, name, provider, category, url, authTokenEnv, currentMonthCostPath, previousMonthCostPath, currencyPath, usageValuePath.
OPERATIONS_LIVE_COST_FEEDS=
OPERATIONS_BASE_CURRENCY=PGK
# Map each provider currency into the base currency, for example: {"USD":3.85,"AUD":2.55}
OPERATIONS_CURRENCY_RATES=

# Postgres connection (used by setup/migration scripts)
DATABASE_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# Email (Resend)
RESEND_API_KEY=your-resend-api-key
FROM_EMAIL=no-reply@example.com
