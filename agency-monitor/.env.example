# Copy to .env.local for each NEW, independently provisioned agency Supabase project.
# NEVER use NJSS project credentials for a different agency.
NEXT_PUBLIC_SUPABASE_URL=https://your-new-agency-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-agency-publishable-key
# Server ONLY: required for secure document / logo upload routes and initial admin provisioning.
# Do not prefix with NEXT_PUBLIC_. Never commit real secrets.
SUPABASE_SERVICE_ROLE_KEY=your-agency-server-only-service-role-key
# For the first one-time administrator bootstrap, set these only in an authorised shell.
# ALLOW_AGENCY_BOOTSTRAP=YES_I_APPROVE
# BOOTSTRAP_PROJECT_REF=your-new-agency-project
# BOOTSTRAP_AUTH_USER_ID=verified-supabase-auth-uuid
# BOOTSTRAP_FULL_NAME=Agency System Administrator

# Required for scripts/verify-installation.mjs, never an NJSS project ref.
AGENCY_PROJECT_REF=your-new-agency-project-ref
